# Copy this file to .env for local use. Never commit .env.
ENTSOE_API_KEY=PASTE_YOUR_TOKEN_HERE

# Optional: protect the whole dashboard with HTTP Basic Auth.
# Leave both empty to disable authentication locally.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
# Deliberately public (test use): hide the UI warning.
DASHBOARD_PUBLIC_OK=

# Optional: netztransparenz.de API client (Germany-wide NRV-Saldo, aFRR/mFRR).
NTP_CLIENT_ID=
NTP_CLIENT_SECRET=

# Optional overrides
ENTSOE_ENDPOINT_URL=https://web-api.tp.entsoe.eu/api
ENTSOE_REFRESH_SECONDS=300
ENTSOE_CACHE_SECONDS=240
ENTSOE_CACHE_MAX_ENTRIES=256
ENTSOE_HTTP_TIMEOUT=35
ENTSOE_MAX_REQUESTS_PER_MINUTE=300
# Cache for past delivery days (seconds)
ENTSOE_PAST_DAY_CACHE_SECONDS=3600
LOG_LEVEL=INFO
# Background refresh of today's panels (0 = off, like v5.1)
BACKGROUND_REFRESH=1
# Preliminary imbalance from netztransparenz RZ-Saldo (0 = off, like v5.3)
NTP_IMBALANCE_NOWCAST=1
# v5.9: bridge a control area that is late on ENTSO-E (0 = off, like v5.8)
GAPFILL=1
# ... once the official German total is older than this many minutes
GAPFILL_AFTER_MINUTES=75
# Status bar turns yellow when official actuals are older than this
STALE_ACTUAL_MINUTES=90
PORT=8000
